{
  "name": "stagepass-hexagonal",
  "version": "1.0.0",
  "description": "StagePass Live: plataforma de boletería digital con Arquitectura Hexagonal (Taller 13, UNAB)",
  "type": "module",
  "author": "Luisa Fernanda Velandia Salamanca",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copiar-publico.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.9.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
